  @@index([workspaceId, brandProfileId, createdAt])
  @@map("script_tournaments")
}

model ScriptVariant {
  id              String   @id @default(uuid()) @db.Uuid
  workspaceId     String   @map("workspace_id") @db.Uuid
  tournamentId    String   @map("tournament_id") @db.Uuid
  index           Int
  status          String   @db.VarChar(40)
  hookType        String   @map("hook_type") @db.VarChar(80)
  hook            String   @db.Text
  body            String   @db.Text
  cta             String   @db.Text
  captions        String   @db.Text
  claims          Json
  cadence         Json
  formulaSlots    Json     @map("formula_slots")
  provenance      Json
