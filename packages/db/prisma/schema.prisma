// Product V0 F3 identity, tenancy, idempotency and artifact schema.
// Sources: docs/V0/V0_PRISMA_SCHEMA.md and docs/V0/Sprints/V0-F3_PRIVATE_ARTIFACT_UPLOAD_QUARANTINE_AND_AUTHORIZED_RETRIEVAL_SPRINT.md.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipRole {
  OWNER
  ADMIN
  CLIENT_MANAGER
  REVIEWER

  @@map("membership_role")
}

enum RecordStatus {
  ACTIVE
  ARCHIVED
  DELETED

  @@map("record_status")
}

enum AssetTrustStatus {
  QUARANTINED
  VALIDATING
  CLEAN
  REJECTED
  DELETED

  @@map("asset_trust_status")
}

enum JobStatus {
  CREATED
  QUEUED
  LEASED
  RUNNING
  RETRY_WAIT
  SUCCEEDED
  FAILED
  CANCEL_REQUESTED
  CANCELLED
  EXPIRED

  @@map("job_status")
}

// V0-G2 creator wallet and verified credit purchase. Purchases move through the
// CreditPurchaseStatus lifecycle; the ledger is append-only and uses
// CreditLedgerType. RESERVE/CAPTURE/RELEASE belong to V0-G3 atomic reservation
// and are present in the enum so G3 can use them without a migration.
enum CreditPurchaseStatus {
  INITIATED
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  DISPUTED

  @@map("credit_purchase_status")
}

enum CreditLedgerType {
  PURCHASE
  RESERVE
  CAPTURE
  RELEASE
  ADJUSTMENT
  REFUND

  @@map("credit_ledger_type")
}

// V0-G3 atomic credit reservation status. The DB enum is uppercase; the public
// API normalizes it to the lowercase V0_STATUS_ENUMS.md Reservation contract
// (active, captured, released, expired, adjusted) at the mapper boundary.
enum CreditReservationStatus {
  ACTIVE
  CAPTURED
  RELEASED
  EXPIRED
  ADJUSTED

  @@map("credit_reservation_status")
}

// V0-G4 provider operation status. The DB enum is uppercase; the public API
// lowercases it at the mapper boundary. CREATED is the pre-network durable row;
// SUBMITTING covers the network I/O; ACCEPTED/PROCESSING/COMPLETED are the happy
// path; UNKNOWN marks a timeout after possible acceptance (reconciled before any
// retry, never collapsed to success or failure); REJECTED/FAILED are terminal
// failures; CANCELLED is the cancellation terminal. The spec enum does not list a
// separate RECONCILED value: reconciliation of UNKNOWN is recorded by
// `reconciledAt` and a transition out of UNKNOWN to a terminal state.
enum ProviderOperationStatus {
  CREATED
  SUBMITTING
  ACCEPTED
  UNKNOWN
  PROCESSING
  COMPLETED
  REJECTED
  FAILED
  CANCELLED

  @@map("provider_operation_status")
}

// V0-U2 publish operation status. A dedicated enum mirroring ProviderOperationStatus so the
// publishing lifecycle (created -> submitting -> accepted -> processing -> completed, with
// unknown for a timeout after possible acceptance and rejected/failed/cancelled terminals) is
// distinct from the paid generation lifecycle. The DB enum is uppercase; the public API
// lowercases it at the mapper boundary. UNKNOWN marks a timeout after possible acceptance and is
// reconciled before any retry, never collapsed to success or failure; reconciliation of UNKNOWN
// is recorded by `reconciledAt` and a transition out of UNKNOWN to a terminal state. The
// CalendarPost.PublishStatus advances in lockstep with this operation but has no UNKNOWN value;
// while the operation is UNKNOWN the post stays SUBMITTING and the operation carries the precise
// uncertain truth.
enum PublishOperationStatus {
  CREATED
  SUBMITTING
  ACCEPTED
  UNKNOWN
  PROCESSING
  COMPLETED
  REJECTED
  FAILED
  CANCELLED

  @@map("publish_operation_status")
}

// V0-C1 composition instruction status. Lowercase values per docs/V0/V0_STATUS_ENUMS.md.
// C1 reaches draft/planning/validation_failed/validated; rendering/rendered/failed/superseded
// are owned by later composition sprints and are present so the enum is complete up front.
enum CompositionStatus {
  DRAFT
  PLANNING
  VALIDATION_FAILED
  VALIDATED
  RENDERING
  RENDERED
  FAILED
  SUPERSEDED

  @@map("composition_status")
}

// V0-C2 render attempt status. The render is a costly worker mutation producing retained
// artifacts, so a RenderAttempt is persisted RUNNING before the AE worker runs and moves to
// SUCCEEDED (final media retained) or FAILED (capability drift, incompatible output, crash
// that could not recover). The public mapper lowercases the value.
enum RenderAttemptStatus {
  RUNNING
  SUCCEEDED
  FAILED

  @@map("render_attempt_status")
}

// V0-C2 final video revision status. Exactly one CURRENT final video exists per composition
// instruction; a new revision supersedes the prior CURRENT row (set to SUPERSEDED) without
// overwriting it, preserving the immutable revision lineage. The public mapper lowercases.
enum FinalVideoStatus {
  CURRENT
  SUPERSEDED

  @@map("final_video_status")
}

model User {
  id          String       @id @db.Uuid
  email       String?      @db.VarChar(320)
  displayName String?      @map("display_name") @db.VarChar(160)
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  memberships Membership[]
  auditEvents AuditEvent[] @relation("AuditActor")
  idempotencyRecords IdempotencyRecord[] @relation("IdempotencyActor")
  updatedWorkspaceCapabilities WorkspaceCapability[]
  serviceCredentialsUpdated ServiceCredential[]
  selectedScriptsAsApprover SelectedScript[] @relation("SelectedScriptApprover")

  @@map("users")
}

model Workspace {
  id          String       @id @default(uuid()) @db.Uuid
  name        String       @db.VarChar(120)
  slug        String       @db.VarChar(140)
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  memberships Membership[]
  auditEvents AuditEvent[]
  idempotencyRecords IdempotencyRecord[]
  artifacts Artifact[]
  brandCrawlRuns BrandCrawlRun[]
  brandAssets BrandAsset[]
  brandCandidates BrandCandidate[]
  brandProfiles BrandProfile[]
  brandApprovals BrandApproval[]
  brandRules BrandRule[]
  generationEstimates GenerationEstimate[]
  blueprintLibraryEntries BlueprintLibraryEntry[]
  blueprintRequests BlueprintRequest[]
  formulaDerivations FormulaDerivation[]
  directorPrompts DirectorPrompt[]
  viralCandidates ViralCandidate[]
  metricSnapshots MetricSnapshot[]
  mediaAcquisitions MediaAcquisition[]
  thumbnailBlueprints ThumbnailBlueprint[]
  videoBlueprints VideoBlueprint[]
  blueprintScenes BlueprintScene[]
  scriptTournaments ScriptTournament[]
  scriptVariants ScriptVariant[]
  scriptEvaluations ScriptEvaluation[]
  selectedScripts SelectedScript[]
  avatars AvatarProfile[]
  avatarConsents AvatarConsent[]
  creditWallets CreditWallet[]
  creditPurchases CreditPurchase[]
  creditLedgerEntries CreditLedgerEntry[]
  inboxEvents InboxEvent[]
  jobs Job[]
  jobAttempts JobAttempt[]
  jobEvents JobEvent[]
  outboxEvents OutboxEvent[]
  capabilities WorkspaceCapability[]
  serviceCredentials ServiceCredential[]
  generationJobs GenerationJob[]
  creditReservations CreditReservation[]
  providerOperations ProviderOperation[]
  generatedSegments GeneratedSegment[]
  generatedAssets GeneratedAsset[]
  lineages CreativeLineage[]
  compositionInstructions CompositionInstruction[]
  aePlans AePlan[]
  renderAttempts RenderAttempt[]
  finalVideos FinalVideo[]
  reviewItems ReviewItem[]
  reviewComments ReviewComment[]
  notifications Notification[]
  reviewDecisions ReviewDecision[]
  calendarPosts CalendarPost[]
  publishOperations PublishOperation[]
  postVerifications PostVerification[]
  performanceSnapshots PerformanceSnapshot[]

  @@unique([slug])
  @@index([status, createdAt])
  @@map("workspaces")
}

model ServiceCredential {
  id              String   @id @default(uuid()) @db.Uuid
  workspaceId     String   @map("workspace_id") @db.Uuid
  provider        String   @db.VarChar(120)
  purpose         String   @db.VarChar(120)
  environment     String   @db.VarChar(80)
  secretRef       String   @map("secret_ref") @db.VarChar(300)
  rotationStatus  String   @map("rotation_status") @db.VarChar(80)
  updatedByUserId String?  @map("updated_by_user_id") @db.Uuid
  lastRotatedAt   DateTime? @map("last_rotated_at") @db.Timestamptz(6)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspace       Workspace @relation(fields: [workspaceId], references: [id])
  updatedBy       User?     @relation(fields: [updatedByUserId], references: [id])

  @@index([workspaceId, provider, environment])
  @@map("service_credentials")
}

model WorkspaceCapability {
  id              String    @id @default(uuid()) @db.Uuid
  workspaceId     String    @map("workspace_id") @db.Uuid
  capability      String    @db.VarChar(120)
  enabled         Boolean   @default(true)
  disabledReason  String?   @map("disabled_reason") @db.VarChar(500)
  updatedByUserId String    @map("updated_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspace       Workspace @relation(fields: [workspaceId], references: [id])
  updatedBy       User      @relation(fields: [updatedByUserId], references: [id])

  @@unique([workspaceId, capability])
  @@index([workspaceId, enabled])
  @@map("workspace_capabilities")
}

model Membership {
  id          String         @id @default(uuid()) @db.Uuid
  workspaceId String         @map("workspace_id") @db.Uuid
  userId      String         @map("user_id") @db.Uuid
  role        MembershipRole
  status      RecordStatus   @default(ACTIVE)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspace   Workspace      @relation(fields: [workspaceId], references: [id])
  user        User           @relation(fields: [userId], references: [id])

  @@unique([workspaceId, userId])
  @@index([userId, status])
  @@index([workspaceId, role])
  @@map("memberships")
}

model AuditEvent {
  id            String    @id @default(uuid()) @db.Uuid
  workspaceId   String?   @map("workspace_id") @db.Uuid
  actorUserId   String?   @map("actor_user_id") @db.Uuid
  eventType     String    @map("event_type") @db.VarChar(120)
  targetType    String?   @map("target_type") @db.VarChar(120)
  targetId      String?   @map("target_id") @db.Uuid
  reason        String?   @db.VarChar(500)
  occurredAt    DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(6)
  workspace     Workspace? @relation(fields: [workspaceId], references: [id])
  actor         User?      @relation("AuditActor", fields: [actorUserId], references: [id])

  @@index([workspaceId, occurredAt])
  @@index([actorUserId, occurredAt])
  @@map("audit_events")
}

model IdempotencyRecord {
  id             String    @id @default(uuid()) @db.Uuid
  workspaceId    String?   @map("workspace_id") @db.Uuid
  actorUserId    String    @map("actor_user_id") @db.Uuid
  operation      String    @db.VarChar(120)
  idempotencyKey String    @map("idempotency_key") @db.VarChar(200)
  requestHash    String    @map("request_hash") @db.Char(64)
  responseStatus Int       @map("response_status")
  responseBody   Json      @map("response_body")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  workspace      Workspace? @relation(fields: [workspaceId], references: [id])
  actor          User      @relation("IdempotencyActor", fields: [actorUserId], references: [id])

  @@unique([workspaceId, operation, idempotencyKey])
  @@unique([actorUserId, operation, idempotencyKey])
  @@index([actorUserId, operation, createdAt])
  @@map("idempotency_records")
}

model Artifact {
  id             String           @id @default(uuid()) @db.Uuid
  workspaceId    String           @map("workspace_id") @db.Uuid
  fileName       String           @map("file_name") @db.VarChar(240)
  contentType    String           @map("content_type") @db.VarChar(120)
  byteSize       Int              @map("byte_size")
  sha256         String           @db.Char(64)
  status         AssetTrustStatus @default(QUARANTINED)
  retentionClass String           @map("retention_class") @db.VarChar(80)
  producer       String           @db.VarChar(120)
  schemaVersion  String           @map("schema_version") @db.VarChar(80)
  objectKey      String           @map("object_key") @db.VarChar(500)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspace      Workspace        @relation(fields: [workspaceId], references: [id])
  brandAssets    BrandAsset[]
  mediaAcquisitions MediaAcquisition[]
  thumbnailBlueprints ThumbnailBlueprint[]
  generatedSegments GeneratedSegment[]
  generatedAssets GeneratedAsset[]
  aePlans AePlan[]
  renderAttemptLogs RenderAttempt[]
  finalVideosAsVideo FinalVideo[] @relation("FinalVideoFinalVideoArtifact")
  finalVideosAsThumbnail FinalVideo[] @relation("FinalVideoThumbnailArtifact")
  finalVideosAsCaptions FinalVideo[] @relation("FinalVideoCaptionsArtifact")
  calendarPostExports CalendarPost[] @relation("CalendarPostExportArtifact")
  postVerificationEvidence PostVerification[] @relation("PostVerificationEvidenceArtifact")

  @@index([workspaceId, status, createdAt])
  @@index([workspaceId, updatedAt, id])
  @@map("artifacts")
}

model BrandCrawlRun {
  id                 String       @id @default(uuid()) @db.Uuid
  workspaceId        String       @map("workspace_id") @db.Uuid
  sourceUrl          String       @map("source_url") @db.VarChar(1000)
  normalizedUrl      String       @map("normalized_url") @db.VarChar(500)
  status             JobStatus    @default(QUEUED)
  rightsAcknowledged Boolean      @map("rights_acknowledged")
  crawlScope         Json         @map("crawl_scope")
  robotsPolicy       Json?        @map("robots_policy")
  jobId              String?      @map("job_id") @db.Uuid
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspace          Workspace    @relation(fields: [workspaceId], references: [id])
  brandAssets        BrandAsset[]
  brandCandidates    BrandCandidate[]
  brandProfiles      BrandProfile[]

  @@index([workspaceId, status, createdAt])
  @@index([workspaceId, normalizedUrl])
  @@map("brand_crawl_runs")
}

model BrandAsset {
  id           String        @id @default(uuid()) @db.Uuid
  workspaceId  String        @map("workspace_id") @db.Uuid
  crawlRunId   String        @map("crawl_run_id") @db.Uuid
  artifactId   String        @map("artifact_id") @db.Uuid
  rightsBasis  String        @map("rights_basis") @db.VarChar(240)
  permittedUse String        @map("permitted_use") @db.VarChar(240)
  status       RecordStatus  @default(ACTIVE)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspace    Workspace     @relation(fields: [workspaceId], references: [id])
  crawlRun     BrandCrawlRun @relation(fields: [crawlRunId], references: [id])
  artifact     Artifact      @relation(fields: [artifactId], references: [id])

  @@unique([workspaceId, artifactId, crawlRunId])
  @@index([workspaceId, status, createdAt])
  @@map("brand_assets")
}

model BrandCandidate {
  id                String        @id @default(uuid()) @db.Uuid
  workspaceId       String        @map("workspace_id") @db.Uuid
  crawlRunId        String        @map("crawl_run_id") @db.Uuid
  fieldType         String        @map("field_type") @db.VarChar(120)
  value             Json
  confidence        Decimal       @db.Decimal(4, 3)
  decision          String        @default("candidate") @db.VarChar(80)
  extractionState   String        @map("extraction_state") @db.VarChar(80)
  sourceEvidence    Json          @map("source_evidence")
  conflict          Boolean       @default(false)
  sourceFingerprint String        @map("source_fingerprint") @db.Char(64)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspace         Workspace     @relation(fields: [workspaceId], references: [id])
  crawlRun          BrandCrawlRun @relation(fields: [crawlRunId], references: [id])

  @@unique([workspaceId, crawlRunId, fieldType, sourceFingerprint])
  @@index([workspaceId, crawlRunId, fieldType])
  @@index([workspaceId, extractionState, createdAt])
  @@map("brand_candidates")
}

model BrandProfile {
  id               String        @id @default(uuid()) @db.Uuid
  workspaceId      String        @map("workspace_id") @db.Uuid
  brandId          String        @map("brand_id") @db.Uuid
  crawlRunId       String        @map("crawl_run_id") @db.Uuid
  schemaVersion    String        @map("schema_version") @db.VarChar(80)
  version          Int
  status           String        @db.VarChar(40)
  active           Boolean       @default(false)
  profile          Json
  sourceSummary    Json          @map("source_summary")
  approvedByUserId String        @map("approved_by_user_id") @db.Uuid
  approvedAt       DateTime      @map("approved_at") @db.Timestamptz(6)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspace        Workspace     @relation(fields: [workspaceId], references: [id])
  crawlRun         BrandCrawlRun @relation(fields: [crawlRunId], references: [id])
  approvals        BrandApproval[]
  rules            BrandRule[]
  generationEstimates GenerationEstimate[]
  blueprintLibraryEntries BlueprintLibraryEntry[]
  blueprintRequests BlueprintRequest[]
  scriptTournaments ScriptTournament[]
  avatars AvatarProfile[]
  generationJobs GenerationJob[]
  lineages CreativeLineage[]

  @@unique([workspaceId, brandId, version])
  @@index([workspaceId, brandId, status, active])
  @@map("brand_profiles")
}

model BrandApproval {
  id             String       @id @default(uuid()) @db.Uuid
  workspaceId    String       @map("workspace_id") @db.Uuid
  brandProfileId String       @map("brand_profile_id") @db.Uuid
  brandId        String       @map("brand_id") @db.Uuid
  actorUserId    String       @map("actor_user_id") @db.Uuid
  decision       String       @db.VarChar(40)
  reason         String?      @db.VarChar(500)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  workspace      Workspace    @relation(fields: [workspaceId], references: [id])
  brandProfile   BrandProfile @relation(fields: [brandProfileId], references: [id])

  @@index([workspaceId, brandId, createdAt])
  @@map("brand_approvals")
}

model BrandRule {
  id             String       @id @default(uuid()) @db.Uuid
  workspaceId    String       @map("workspace_id") @db.Uuid
  brandProfileId String       @map("brand_profile_id") @db.Uuid
  brandId        String       @map("brand_id") @db.Uuid
  type           String       @db.VarChar(80)
  value          String       @db.VarChar(500)
  severity       String       @db.VarChar(40)
  rationale      String       @db.VarChar(500)
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspace      Workspace    @relation(fields: [workspaceId], references: [id])
  brandProfile   BrandProfile @relation(fields: [brandProfileId], references: [id])

  @@unique([workspaceId, brandProfileId, type, value])
  @@index([workspaceId, brandId, status])
  @@map("brand_rules")
}

model GenerationEstimate {
  id                     String       @id @default(uuid()) @db.Uuid
  workspaceId            String       @map("workspace_id") @db.Uuid
  brandProfileId         String       @map("brand_profile_id") @db.Uuid
  status                 String       @db.VarChar(40)
  provider               String       @db.VarChar(80)
  priceVersion           String       @map("price_version") @db.VarChar(80)
  maximumAuthorizedMinor BigInt       @map("maximum_authorized_minor")
  currency               String       @db.VarChar(3)
  selectedScriptId       String       @map("selected_script_id") @db.Uuid
  avatarProfileId        String       @map("avatar_profile_id") @db.Uuid
  // V0-G3 versioned-estimate guards. inputHash binds the exact script/avatar/
  // duration the user saw; expiresAt drives ESTIMATE_EXPIRED; version backs the
  // optimistic RESOURCE_VERSION_STALE guard; confirmedAt records reservation.
  inputHash              String?      @map("input_hash") @db.VarChar(64)
  expiresAt              DateTime?    @map("expires_at") @db.Timestamptz(6)
  version                Int          @default(1)
  confirmedAt            DateTime?    @map("confirmed_at") @db.Timestamptz(6)
  durationSeconds        Int          @map("duration_seconds") @default(30)
  createdAt              DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspace              Workspace    @relation(fields: [workspaceId], references: [id])
  brandProfile           BrandProfile @relation(fields: [brandProfileId], references: [id])
  jobs                   GenerationJob[]
  lineages               CreativeLineage[]

  @@index([workspaceId, brandProfileId, status])
  @@map("generation_estimates")
}

model BlueprintLibraryEntry {
  id              String       @id @default(uuid()) @db.Uuid
  workspaceId     String       @map("workspace_id") @db.Uuid
  brandProfileId  String       @map("brand_profile_id") @db.Uuid
  title           String       @db.VarChar(200)
  status          String       @db.VarChar(40)
  compatibility   Json
  createdByUserId String       @map("created_by_user_id") @db.Uuid
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspace       Workspace    @relation(fields: [workspaceId], references: [id])
  brandProfile    BrandProfile @relation(fields: [brandProfileId], references: [id])
  blueprintRequests BlueprintRequest[]
  formulaDerivations FormulaDerivation[]
  directorPrompts DirectorPrompt[]
  scriptTournaments ScriptTournament[]

  @@index([workspaceId, status, createdAt])
  @@index([workspaceId, updatedAt, id])
  @@map("blueprint_library_entries")
}

model BlueprintRequest {
  id                      String       @id @default(uuid()) @db.Uuid
  workspaceId             String       @map("workspace_id") @db.Uuid
  path                    String       @db.VarChar(40)
  brandProfileId          String       @map("brand_profile_id") @db.Uuid
  brandProfileVersion     Int          @map("brand_profile_version")
  blueprintLibraryEntryId String?      @map("blueprint_library_entry_id") @db.Uuid
  objectiveType           String       @map("objective_type") @db.VarChar(120)
  objective               String       @db.VarChar(500)
  status                  String       @db.VarChar(40)
  createdByUserId         String       @map("created_by_user_id") @db.Uuid
  createdAt               DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspace               Workspace    @relation(fields: [workspaceId], references: [id])
  brandProfile            BrandProfile @relation(fields: [brandProfileId], references: [id])
  blueprintLibraryEntry   BlueprintLibraryEntry? @relation(fields: [blueprintLibraryEntryId], references: [id])
  viralCandidates         ViralCandidate[]
  formulaDerivations      FormulaDerivation[]
  directorPrompts         DirectorPrompt[]
  scriptTournaments       ScriptTournament[]

  @@index([workspaceId, status, createdAt])
  @@index([workspaceId, brandProfileId, createdAt])
  @@map("blueprint_requests")
}

model FormulaDerivation {
  id                      String                @id @default(uuid()) @db.Uuid
  workspaceId             String                @map("workspace_id") @db.Uuid
  blueprintLibraryEntryId String                @map("blueprint_library_entry_id") @db.Uuid
  blueprintRequestId      String                @map("blueprint_request_id") @db.Uuid
  status                  String                @db.VarChar(40)
  formulaVersion          String                @map("formula_version") @db.VarChar(80)
  slots                   Json
  replacementInstructions Json                  @map("replacement_instructions")
  lineage                 Json
  createdAt               DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspace               Workspace             @relation(fields: [workspaceId], references: [id])
  blueprintLibraryEntry   BlueprintLibraryEntry @relation(fields: [blueprintLibraryEntryId], references: [id])
  blueprintRequest        BlueprintRequest      @relation(fields: [blueprintRequestId], references: [id])
  directorPrompts         DirectorPrompt[]
  scriptTournaments       ScriptTournament[]

  @@unique([workspaceId, blueprintLibraryEntryId])
  @@index([workspaceId, status, createdAt])
  @@map("formula_derivations")
}

model DirectorPrompt {
  id                      String                @id @default(uuid()) @db.Uuid
  workspaceId             String                @map("workspace_id") @db.Uuid
  blueprintLibraryEntryId String                @map("blueprint_library_entry_id") @db.Uuid
  formulaDerivationId     String                @map("formula_derivation_id") @db.Uuid
  blueprintRequestId      String                @map("blueprint_request_id") @db.Uuid
  status                  String                @db.VarChar(40)
  promptVersion           String                @map("prompt_version") @db.VarChar(80)
  replacementSlots        Json                  @map("replacement_slots")
  prompt                  String                @db.Text
  lineage                 Json
  createdAt               DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspace               Workspace             @relation(fields: [workspaceId], references: [id])
  blueprintLibraryEntry   BlueprintLibraryEntry @relation(fields: [blueprintLibraryEntryId], references: [id])
  formulaDerivation       FormulaDerivation     @relation(fields: [formulaDerivationId], references: [id])
  blueprintRequest        BlueprintRequest      @relation(fields: [blueprintRequestId], references: [id])
  scriptTournaments       ScriptTournament[]

  @@unique([workspaceId, blueprintLibraryEntryId])
  @@index([workspaceId, status, createdAt])
  @@map("director_prompts")
}

model ScriptTournament {
  id                      String   @id @default(uuid()) @db.Uuid
  workspaceId             String   @map("workspace_id") @db.Uuid
  blueprintRequestId       String   @map("blueprint_request_id") @db.Uuid
  blueprintLibraryEntryId  String   @map("blueprint_library_entry_id") @db.Uuid
  formulaDerivationId      String   @map("formula_derivation_id") @db.Uuid
  directorPromptId         String   @map("director_prompt_id") @db.Uuid
  brandProfileId           String   @map("brand_profile_id") @db.Uuid
  brandProfileVersion      Int      @map("brand_profile_version")
  objectiveType             String   @map("objective_type") @db.VarChar(120)
  objective                 String   @db.VarChar(500)
  requestedVariantCount     Int      @map("requested_variant_count")
  validVariantCount         Int      @map("valid_variant_count")
  status                    String   @db.VarChar(40)
  result                    String   @db.VarChar(40)
  promptVersion             String   @map("prompt_version") @db.VarChar(80)
  modelVersion              String   @map("model_version") @db.VarChar(80)
  telemetry                 Json
  manifestArtifactId        String?  @map("manifest_artifact_id") @db.Uuid
  jobId                      String?  @map("job_id") @db.Uuid
  createdByUserId           String   @map("created_by_user_id") @db.Uuid
  createdAt                 DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspace                 Workspace             @relation(fields: [workspaceId], references: [id])
  blueprintRequest          BlueprintRequest      @relation(fields: [blueprintRequestId], references: [id])
  blueprintLibraryEntry     BlueprintLibraryEntry @relation(fields: [blueprintLibraryEntryId], references: [id])
  formulaDerivation         FormulaDerivation     @relation(fields: [formulaDerivationId], references: [id])
  directorPrompt            DirectorPrompt        @relation(fields: [directorPromptId], references: [id])
  brandProfile              BrandProfile          @relation(fields: [brandProfileId], references: [id])
  variants                  ScriptVariant[]
  evaluations               ScriptEvaluation[]
  selection                 SelectedScript?

