  workspace       Workspace @relation(fields: [workspaceId], references: [id])
  tournament      ScriptTournament @relation(fields: [tournamentId], references: [id])
  evaluation      ScriptEvaluation?
  selection       SelectedScript?

  @@index([workspaceId, tournamentId, index])
  @@map("script_variants")
}

model ScriptEvaluation {
  id               String   @id @default(uuid()) @db.Uuid
  workspaceId      String   @map("workspace_id") @db.Uuid
  tournamentId     String   @map("tournament_id") @db.Uuid
  variantId        String   @unique @map("variant_id") @db.Uuid
  status           String   @db.VarChar(40)
  hookStrength     Json     @map("hook_strength")
  timing           Json
  patternInterrupts Json     @map("pattern_interrupts")
  cta              Json
  claims           Json
  captions         Json
  tone             Json
  formulaChecks    Json     @map("formula_checks")
  policyChecks     Json     @map("policy_checks")
  brandRuleChecks  Json     @map("brand_rule_checks")
  modelScore       Float    @map("model_score")
  humanScore       Float?   @map("human_score")
  explanation      String   @db.Text
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
