# Copy values into a local, untracked environment file.
# Never place production credentials or real customer data here.

APP_ENV=local
APP_VERSION=dev
LOG_LEVEL=debug
PUBLIC_WEB_URL=http://localhost:3000
API_BASE_URL=http://localhost:3001/api/v0
DEFAULT_TIMEZONE=Asia/Kolkata
DEFAULT_CURRENCY=INR

NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v0
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=local-publishable-placeholder
NEXT_PUBLIC_ANALYTICS_ENABLED=false

DATABASE_URL=postgresql://v0_runtime:local_only@localhost:5432/v0
DIRECT_DATABASE_URL=postgresql://v0_migration:local_only@localhost:5432/v0
SUPABASE_URL=http://localhost:54321
SUPABASE_JWT_ISSUER=http://localhost:54321/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWKS_URL=http://localhost:54321/auth/v1/.well-known/jwks.json

REDIS_URL=redis://localhost:6379
QUEUE_PREFIX=v0-local
QUEUE_CPU_CONCURRENCY=2
QUEUE_GPU_CONCURRENCY=1
QUEUE_AE_CONCURRENCY=1

OBJECT_STORAGE_PROVIDER=local-filesystem
LOCAL_STORAGE_ROOT=.local/storage
B2_BUCKET_QUARANTINE=v0-local-quarantine
B2_BUCKET_CLEAN_MEDIA=v0-local-clean
B2_BUCKET_PRIVATE_ARTIFACTS=v0-local-artifacts
MAX_UPLOAD_BYTES=104857600

WORKER_SERVICE_ID=v0-local-worker
WORKER_AUTH_AUDIENCE=v0-internal-api
WORKER_AUTH_TOKEN=local-worker-token-placeholder
WORKER_CALLBACK_BASE_URL=http://localhost:3001/api/v0/internal
WORKER_MAX_ARTIFACT_BYTES=1073741824

LLM_PROVIDER=simulator
CRAWL_USER_AGENT=SakhaaForgeLocal/0.0 (+http://localhost:3000)
XPOZ_API_BASE_URL=http://localhost:4010/xpoz

HEYGEN_MODE=simulator
HEYGEN_API_BASE_URL=http://localhost:4010/heygen
HEYGEN_CALLBACK_URL=http://localhost:3001/api/v0/callbacks/heygen
HEYGEN_CONCURRENCY_LIMIT=10
HEYGEN_MAX_SCRIPT_CHARACTERS=5000

PAYMENT_MODE=simulator
PAYMENT_CALLBACK_BASE_URL=http://localhost:3001/api/v0/callbacks

PUBLISHING_MODE=simulator
PUBLISH_CALLBACK_BASE_URL=http://localhost:3001/api/v0/callbacks/publishing
VERIFY_RETRY_SCHEDULE_SECONDS=0,60,180,420,900

NOTIFICATION_MODE=log
EMAIL_FROM_NAME=Sakhaa Forge
OTEL_SERVICE_NAME=v0-local
TRACE_SAMPLE_RATIO=1
PRODUCT_ANALYTICS_ENABLED=false
